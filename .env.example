# Copie para .env e preencha. NUNCA faça commit do .env.

# Opção 1: Gemini via chave de API (Google AI Studio)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=sua-chave-aqui

# Opção 2: Vertex AI (comente a opção 1 e use estas)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=seu-projeto
# GOOGLE_CLOUD_LOCATION=us-central1

# Modelo usado pelos agentes (confirme os modelos disponíveis no seu projeto)
ADK_MODEL=gemini-2.5-flash
